 class OmniNPUModelRunner(OmniGPUModelRunner, NPUModelRunner):
+    def _build_attention_metadata(self, *args, **kwargs):
+        metadata = super()._build_attention_metadata(*args, **kwargs)
+        if not (getattr(self.model_config, "enable_return_routed_experts", False) and self.routed_experts_initialized):
+            return metadata
+
+        # Ascend writes the routed-experts slot mapping while building metadata,
+        # but currently hard-codes KV group 0. Hybrid models key the capture by
+        # the full-attention group, so replace it after the final Ascend write.
+        num_tokens = kwargs.get("num_tokens", args[0] if args else None)
+        num_tokens_padded = kwargs.get("num_tokens_padded", args[3] if len(args) > 3 else None)
+        n = num_tokens_padded or num_tokens
+        attn_gid = self.routed_experts_capturer.attn_gid
+        slot_mapping = self.input_batch.block_table[attn_gid].slot_mapping.gpu[:n]
+        # Keep the private buffer: rebinding to the shared block-table storage
+        # would let the next step overwrite it before the async D2H copy completes.
+        self.routed_experts_slot_mapping_device[:n].copy_(slot_mapping)
+        return metadata
+
     def initialize_kv_cache(self, kv_cache_config) -> None:
         """Stage the omni prefix-cache config (hidden / mm tensors reused on hits)."""
         NPUModelRunner.initialize_kv_cache(self, kv_cache_config)
