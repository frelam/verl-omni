+def test_duplicate_replay_rows_fall_back_to_native_routing(monkeypatch):
+    monkeypatch.setattr(RouterReplay, "router_instances", [])
+    router = RouterReplay()
+    router.set_router_replay_action(RouterReplayAction.REPLAY_FORWARD)
+    targets = torch.tensor([[0, 0], [1, 1], [2, 3], [3, 1]], dtype=torch.int64)
+    replay_mask = torch.tensor([True, True, False, True])
+    router.set_target_indices(targets, replay_mask=replay_mask)
+    scores = torch.tensor(
+        [
+            [0.1, 0.2, 0.9, 0.8],
+            [0.9, 0.8, 0.2, 0.1],
+            [0.1, 0.9, 0.8, 0.2],
+            [0.8, 0.9, 0.1, 0.2],
+        ]
+    )
+
+    def native_topk(scores, topk, **_kwargs):
+        return torch.topk(scores, k=topk, dim=1)
+
+    _, indices = router.get_replay_topk(scores, 2, default_compute_topk=native_topk)
+    native_indices = native_topk(scores, 2).indices
+
+    # All-zero and partially duplicated targets cannot survive Megatron's bool
+    # routing_map without collapsing token assignments. Masked rows also stay native.
+    torch.testing.assert_close(indices[:3], native_indices[:3])
+    torch.testing.assert_close(indices[3], targets[3])
+    routing_map = torch.zeros_like(scores, dtype=torch.bool).scatter(1, indices, True)
+    assert routing_map.sum().item() == scores.shape[0] * 2
+
+
+def test_bshd_replay_matches_model_padding_and_sequence_parallel_layout(monkeypatch, tf_config):
+    monkeypatch.setattr(RouterReplay, "router_instances", [])
+    monkeypatch.setattr(router_replay_utils, "TopKRouter", FakeTopKRouter)
+    model = _build_model()
+    routes = torch.nested.as_nested_tensor(
+        [
+            torch.arange(3 * NUM_LAYERS * TOPK, dtype=torch.int16).reshape(3, NUM_LAYERS, TOPK),
+            100 + torch.arange(2 * NUM_LAYERS * TOPK, dtype=torch.int16).reshape(2, NUM_LAYERS, TOPK),
+        ],
+        layout=torch.jagged,
+    )
+    replay_mask = torch.nested.as_nested_tensor(
+        [torch.ones(3, dtype=torch.bool), torch.ones(2, dtype=torch.bool)], layout=torch.jagged
+    )
+    preprocess_calls = []
+
+    def fake_preprocess(value, **kwargs):
+        preprocess_calls.append(kwargs)
+        # Match preprocess_bshd_engine: forced_max_seqlen=5 is further aligned
+        # to six rows for two-way sequence parallelism.
+        padded_length = 6
+        dense_shape = tuple(value.shape[2:])
+        dense = torch.zeros((value.shape[0], padded_length, *dense_shape), dtype=value.dtype)
+        attention_mask = torch.zeros((value.shape[0], padded_length), dtype=torch.bool)
+        for index, part in enumerate(value.unbind()):
+            dense[index, : part.shape[0]] = part
+            attention_mask[index, : part.shape[0]] = True
+        return dense, attention_mask, None
+
+    monkeypatch.setattr(router_replay_utils, "preprocess_bshd_engine", fake_preprocess, raising=False)
+    monkeypatch.setattr(router_replay_utils, "device_name", "cpu")
+    # Sequence parallelism shards the sequence dimension, not the flattened batch dimension.
+    monkeypatch.setattr(router_replay_utils, "scatter_to_sequence_parallel_region", lambda value: value[:3])
+
+    router_replay_utils.set_router_replay_data(
+        routes,
+        attention_mask=None,
+        tf_config=tf_config,
+        replay_mask=replay_mask,
+        model=model,
+        data_format="bshd",
+        forced_max_seqlen=5,
+    )
+
+    dense_routes = fake_preprocess(routes)[0]
+    expected = dense_routes.transpose(0, 1)[:3].flatten(0, 1).permute(1, 0, 2)
+    for layer, module in enumerate(model):
+        torch.testing.assert_close(module.router_replay.target_topk_idx, expected[layer].to(torch.int64))
+        torch.testing.assert_close(
+            module.router_replay.target_replay_mask,
+            torch.tensor([True, True, True, True, True, False]),
+        )
+    assert [call["forced_max_seqlen"] for call in preprocess_calls[:2]] == [5, 5]
+
